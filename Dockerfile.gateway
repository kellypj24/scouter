# Go gateway — multi-stage build.
# Stage 1: compile. Stage 2: minimal runtime image with just the binary.
FROM golang:1.26-alpine AS builder

WORKDIR /build
COPY gateway/go.mod gateway/go.sum ./
RUN go mod download

COPY gateway/ .
RUN go build -o scouter-gateway .

FROM alpine:latest
RUN apk --no-cache add ca-certificates
COPY --from=builder /build/scouter-gateway /scouter-gateway
ENTRYPOINT ["/scouter-gateway"]
