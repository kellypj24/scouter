# LLM provider — ollama | anthropic | bedrock (default: ollama)
SCOUTER_LLM_PROVIDER=ollama

# Ollama (PoC — local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_SQL_MODEL=codellama
OLLAMA_TIMEOUT=30

# Anthropic (Claude)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6

# AWS Bedrock
# AWS_REGION=us-east-1
# BEDROCK_MODEL=anthropic.claude-sonnet-4-6-v1

# Data
DUCKDB_PATH=data/scouter.duckdb
DAGSTER_HOME=dagster_home
